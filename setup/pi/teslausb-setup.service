[Unit]
Description=TeslaUSB setup driver
# DietPi has no rc.local, so setup is driven from here. It must run after the
# network is up because setup fetches its own scripts, and after the boot
# partition is mounted because that is where the config and the progress
# markers live.
After=network-online.target boot.mount
Wants=network-online.target
ConditionPathExists=!/teslausb/TESLAUSB_SETUP_FINISHED

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/root/bin/first-boot.sh
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
