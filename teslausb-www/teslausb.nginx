server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;

    index index.html

    server_name _;

    client_max_body_size 0;
    fastcgi_request_buffering off;

    # Compress text assets (big win for the JS/CSS bundles over Wi-Fi)
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    location /new {
        return 301 /;
    }

    # Fingerprinted bundles never change: cache them aggressively.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        auth_basic off;
    }
    # The entry document must always reflect the latest deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
        auth_basic off;
    }

    location / {
        try_files $uri $uri/ =404;
        auth_basic off;
        auth_basic_user_file /etc/nginx/.htpasswd;
    }

    location /cgi-bin/ {
         auth_basic off;
         auth_basic_user_file /etc/nginx/.htpasswd;
         gzip off;
         root /var/www/html;
         fastcgi_pass  unix:/var/run/fcgiwrap.socket;
         include /etc/nginx/fastcgi_params;
         fastcgi_param SCRIPT_FILENAME  $document_root$fastcgi_script_name;
         fastcgi_max_temp_file_size 0;
    }
    # The one request the viewer makes to Tesla when playing an encrypted clip: it posts a
    # clip's ownership metadata and gets that clip's key back. Tesla's endpoint sends no CORS
    # headers, so a browser on this origin cannot call it directly; forwarding it from here
    # makes it same-origin. Only this path is forwarded, only the small JSON body and the
    # caller's Authorization header pass through, and the video itself is never involved:
    # the browser fetches the ciphertext from /TeslaCam/ as usual and decrypts it locally.
    # The device holds no token and stores nothing.
    location = /tesla/decrypt {
        auth_basic off;
        # Resolve Tesla's host per request, not at startup. A literal host in proxy_pass
        # is looked up when the configuration loads, so nginx could not start at all
        # without working DNS: at boot before the network settles, or anywhere without
        # internet, which took the whole web interface down with it. Public resolvers,
        # since this request needs the internet anyway.
        resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
        set $tesla_dashcam https://dashcam.tesla.com;
        proxy_pass $tesla_dashcam/api/1/decrypt/batch;
        # Tesla answers 426 Upgrade Required to the HTTP/1.0 nginx speaks upstream by default
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name dashcam.tesla.com;
        proxy_set_header Host dashcam.tesla.com;
        proxy_set_header Origin https://dashcam.tesla.com;
        proxy_set_header Referer https://dashcam.tesla.com/;
        proxy_pass_request_headers on;
        proxy_hide_header Set-Cookie;
        proxy_read_timeout 30s;
        client_max_body_size 64k;
        limit_except POST { deny all; }
    }
    location /TeslaCam/ {
         auth_basic off;
         auth_basic_user_file /etc/nginx/.htpasswd;
         root /var/www/html;
         fancyindex on;
         fancyindex_css_href /fancyindex.css;
    }
}
